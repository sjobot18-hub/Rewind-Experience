# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# NEVER expose this to the client. Server-only. (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) - free tier is enough for invite/reset emails
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="The Rewind Experience <no-reply@yourdomain.com>"

# Your deployed app URL, used to build invite/reset links
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
